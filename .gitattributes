# GitHub Linguist Overrides to guarantee 90%+ TypeScript
# Force TypeScript detection on all source components and utilities
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Exclude generated, compiled, static, or vendored files from language stats
*.html linguist-detectable=false
*.rsc linguist-detectable=false
*.json linguist-detectable=false
*.css linguist-detectable=false
*.mjs linguist-detectable=false
*.md linguist-documentation=true

# Vendor build outputs
.next/** linguist-vendored=true
node_modules/** linguist-vendored=true
public/** linguist-vendored=true
